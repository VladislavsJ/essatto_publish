# Copy to .env and fill in. .env is ignored by git. Never commit real values.

# Required to start serve.py: visitors open  https://<host>/?code=<this value>  (at least 8 characters).
# Generate one with:  openssl rand -hex 8
BP_ACCESS_CODE=

# Keys for model calls: the one matching the models named in models.json. Set BP_NO_LLM=1 to run with no model calls.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which models are used is set in models.json (basic, smart, effort). These override it without editing the file.
# BP_MODEL_BASIC=claude-haiku-5-5
# BP_MODEL_SMART=none
# BP_MODEL_EFFORT=low

# Cap on model calls per server start.
BP_MAX_MODEL_CALLS=400

# Detector: the Python that has PyTorch and ultralytics, and the weights.
# BP_DET_PYTHON=/usr/bin/python3
# BP_DET_WEIGHTS=models/floorplan_detector_yolo26m_1536.pt
# BP_DET_FIX_WEIGHTS=
# BP_DET_REPORT=cache/detector_heldout_report.json

# Path to the hackathon dataset, only for the evaluation scripts.
# BP_DATA=/path/to/junction-dataset

# Exchange rate used for the cost shown on the page.
# BP_USD_EUR=0.89
